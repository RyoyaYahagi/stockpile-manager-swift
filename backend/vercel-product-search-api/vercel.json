{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/support",
      "destination": "/api/support"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
